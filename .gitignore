# .gitignore
*.csv
# Survivorship-free S&P 500 membership: version the small canonical interval
# table, but not the bulky re-fetchable raw source snapshots (provenance summary
# lives in the tracked build_report.md).
!quant_fund_agent/data/universes/membership/sp500.csv
# ...and its siblings: the Nasdaq-100 table and the preserved free reconstruction
# that the FMP-native build is reconciled against (see FMP_PREMIUM_ARCHIVE.md).
!quant_fund_agent/data/universes/membership/nasdaq100.csv
!quant_fund_agent/data/universes/membership/sp500_public.csv
quant_fund_agent/data/universes/membership/sources/
ticker_data/
binSamples/
fillSamples/
AAPL_2025-10-01_2025-10-01_1/
__pycache__/
*.pyc
.env

# Factor Researcher Agent emits Python files into this directory at
# runtime; they are ephemeral and must not be tracked.  Only the
# package marker stays.
quant_fund_agent/factors/researcher/*
!quant_fund_agent/factors/researcher/__init__.py
claude.md

# showcase_pipeline/ writes generated factors/strategies into separate
# showcase database copies at runtime; these are regenerated locally and
# must not be tracked.
data/factors/showcase_factor_db.json
data/strategies/showcase_strategy_db.json
# Stage 4 (Portfolio Manager) showcase: a synthetic strategy book + its
# generated return series + the PM's allocation decisions, all rebuilt on run.
data/strategies/showcase_pm_strategy_db.json
data/strategies/showcase_pm_returns/
data/portfolio/showcase_pm_portfolio_db.json

# Full text of papers fetched from their links is cached locally (one .txt
# per paper); regenerated on demand, so not tracked.
data/papers/fulltext_cache/

# Vendor market-data parquet cache (yfinance/FMP/AlphaVantage pulls). Re-fetched
# on demand from the provider; user-specific and potentially large, never tracked.
data/market/

# One-time FMP premium archive (scripts/fmp_bulk_download.py): full OHLCV +
# fundamentals for every PIT S&P 500 / Nasdaq-100 member since 2004. Several GB,
# licensed vendor data, and reproducible from the manifest — never tracked.
data/vendor/

# User onboarding config written by `python -m quant_fund_agent.setup`. Holds no
# secrets (those stay in .env) but is environment-specific, so left untracked.
quant.config.yaml
# coverage (pytest-cov)
.coverage
htmlcov/
GLD_2026-06-01_2026-06-11_3

# LOBSTER ingest scratch: raw downloads (auto-deleted per chunk), the resumable
# manifest, and the Playwright cookie session (.lobster_state.json — a secret;
# never commit). All regenerated locally.
data/lobster_raw/
data/lobster_drop/

literature.txt
notes.txt

# Local research notes & external-source attribution log (competitive-landscape
# reports, deep-research syntheses). Working documents, not part of the shipped
# codebase, so left untracked.
research_docs/

# ---------------------------------------------------------------------------
# Local-only thesis material: result artifacts, reports and working documents
# stay on disk but are never pushed. Under data/ only factors, prebooks,
# knowledge and papers (framework inputs, used by the walkthrough notebook)
# remain tracked.
.DS_Store
*.tex
*.tex.bak
*.docx
/*.pdf
important_files.md
docs/
prelim_files/
data/*
!data/factors/
!data/prebooks/
!data/knowledge/
!data/papers/
