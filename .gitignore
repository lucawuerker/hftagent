# .gitignore
*.csv
ticker_data/
binSamples/
fillSamples/
AAPL_2025-10-01_2025-10-01_1/
__pycache__/
*.pyc
.env

# Factor Researcher Agent emits Python files into this directory at
# runtime; they are ephemeral and must not be tracked.  Only the
# package marker stays.
quant_fund_agent/factors/researcher/*
!quant_fund_agent/factors/researcher/__init__.py
claude.md

# showcase_pipeline/ writes generated factors/strategies into separate
# showcase database copies at runtime; these are regenerated locally and
# must not be tracked.
data/factors/showcase_factor_db.json
data/strategies/showcase_strategy_db.json
# Stage 4 (Portfolio Manager) showcase: a synthetic strategy book + its
# generated return series + the PM's allocation decisions, all rebuilt on run.
data/strategies/showcase_pm_strategy_db.json
data/strategies/showcase_pm_returns/
data/portfolio/showcase_pm_portfolio_db.json

# Full text of papers fetched from their links is cached locally (one .txt
# per paper); regenerated on demand, so not tracked.
data/papers/fulltext_cache/

# Vendor market-data parquet cache (yfinance/FMP/AlphaVantage pulls). Re-fetched
# on demand from the provider; user-specific and potentially large, never tracked.
data/market/

# User onboarding config written by `python -m quant_fund_agent.setup`. Holds no
# secrets (those stay in .env) but is environment-specific, so left untracked.
quant.config.yaml
# coverage (pytest-cov)
.coverage
htmlcov/
