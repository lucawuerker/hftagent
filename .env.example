# Copy to `.env` and fill in the keys you have. Only OPENAI_API_KEY is required
# (the LLM agents); the market-data keys are optional and depend on which
# provider you pick in `python -m quant_fund_agent.setup`.

# Required — all agents (Selector / Architect / Statistician / PM / Researcher).
# Any OpenAI-compatible endpoint (e.g. the Meta Model API for Muse Spark) works
# too: keep provider=openai, set FACTOR_RESEARCH_LLM_BASE_URL to the vendor's
# endpoint and point OPENAI_API_KEY at that vendor's key.
OPENAI_API_KEY=
# FACTOR_RESEARCH_LLM_BASE_URL=

# Amazon Bedrock research models (model ids like anthropic.claude-…,
# us.anthropic.…, meta.llama…, amazon.…) use the standard AWS credential chain
# (pip install langchain-aws):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=

# LLM cost metering (quant_fund_agent/llm.py):
#   QF_LLM_PRICES        — JSON overrides {"model-substring": [usd_per_1M_in, usd_per_1M_out]}
#   QF_MAX_LLM_COST_USD  — hard budget; crossing it raises LLMBudgetExceeded.
# QF_LLM_PRICES=
# QF_MAX_LLM_COST_USD=

# Market-data providers (set the one you intend to use):
#   yfinance      — no key required (default for clone-and-run).
#   fmp           — Financial Modeling Prep (Phase 4).
#   alphavantage  — Alpha Vantage (Phase 4); free tier ~25 requests/day.
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
