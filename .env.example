# Copy to `.env` and fill in the keys you have. Only OPENAI_API_KEY is required
# (the LLM agents); the market-data keys are optional and depend on which
# provider you pick in `python -m quant_fund_agent.setup`.

# Required — all agents (Selector / Architect / Statistician / PM / Researcher).
OPENAI_API_KEY=

# Market-data providers (set the one you intend to use):
#   yfinance      — no key required (default for clone-and-run).
#   fmp           — Financial Modeling Prep (Phase 4).
#   alphavantage  — Alpha Vantage (Phase 4); free tier ~25 requests/day.
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
