      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 2,
      "text": "No quality-goal early stop.  Main loop is for gen in 1..generations.\nMax child attempts = generations * children_per_generation.\nScored trials <= seed programs + admitted/evaluable children.\nDefault: up to about 8 seed ideas + 5*8 child attempts.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No quality-goal early stop.  Main loop is for gen in 1..generations.\nMax child attempts = generations * children_per_generation.\nScored trials <= seed programs + admitted/evaluable children.\nDefault: up to about 8 seed ideas + 5*8 child attempts.",
      "autoResize": false,
      "lineHeight": 1.25
    },
