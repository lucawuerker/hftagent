      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 2,
      "text": "SINGLE: genome holds one FactorProgram; marginal value is what it adds to accepted book.\nSET: genome holds multiple programs; primary axis is the set combined VAL IC, independence is internal participation ratio, parsimony is average complexity.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SINGLE: genome holds one FactorProgram; marginal value is what it adds to accepted book.\nSET: genome holds multiple programs; primary axis is the set combined VAL IC, independence is internal participation ratio, parsimony is average complexity.",
      "autoResize": false,
      "lineHeight": 1.25
    },
